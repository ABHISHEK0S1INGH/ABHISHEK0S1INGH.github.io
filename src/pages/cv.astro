---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume | Abhishek Singh" sideBarActiveItemID="cv">
  <div class="space-y-8 pb-12">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-white/10">
      <div>
        <h1 class="text-3xl font-extrabold text-white">Curriculum Vitae</h1>
        <p class="text-sm text-white/50 mt-1">Backend Software Engineer · Health-tech & AI Systems</p>
      </div>
      <a
        href={`${import.meta.env.BASE_URL}resume.pdf`}
        target="_blank" rel="noopener"
        class="liquid-glass-btn-primary inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold w-fit"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Download PDF
      </a>
    </div>

    <!-- Summary -->
    <div class="liquid-glass-card p-5 space-y-2">
      <h2 class="text-lg font-bold text-white">Professional Summary</h2>
      <p class="text-sm text-white/70 leading-relaxed">
        Backend software engineer at Policybazaar, working on DocPrime's healthcare and wellness platform. I build Java and Spring Boot APIs,
        MySQL data models, partner integrations, biometric health services, on-premise AI assistants, and developer productivity workflows.
      </p>
    </div>

    <!-- Experience -->
    <div class="space-y-3">
      <h2 class="text-2xl font-bold text-white">Experience</h2>
      <div class="time-line-container space-y-1">
        <TimeLineElement title="Software Engineer (Backend) — Policybazaar / DocPrime" subtitle="Present · Gurugram">
          Build Java and Spring Boot REST APIs and MySQL schemas for the DocPrime mobile app.
          Integrate partner SDKs and APIs including Hubble Money and Lenskart offers.
          Develop Aisha biometric analysis, PDF health reports, and an on-premise Ollama/RAG assistant.
          Build AI coding agents, automated code-review workflows, and internal AI enablement sessions.
        </TimeLineElement>
      </div>
    </div>

    <!-- Education -->
    <div class="space-y-3">
      <h2 class="text-2xl font-bold text-white">Education</h2>
      <div class="time-line-container">
        <TimeLineElement
          title="Bachelor of Technology — Information Technology"
          subtitle="2021 – 2025 · Dr APJ Abdul Kalam Technical University, Lucknow"
        />
      </div>
    </div>

    <!-- Certifications -->
    <div class="space-y-3">
      <h2 class="text-2xl font-bold text-white">Certifications</h2>
      <div class="liquid-glass-card p-4">
        <div class="font-semibold text-white">Machine Learning & Data Science Program</div>
        <div class="text-sm text-sky-400">GeeksforGeeks · Apr 2024 – Sep 2024</div>
      </div>
    </div>

    <!-- Skills -->
    <div class="space-y-3">
      <h2 class="text-2xl font-bold text-white">Technical Skills</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {[
          { label: "Backend & APIs", color: "text-sky-400", skills: ["Java", "Spring Boot", "REST APIs", "MySQL", "Database Design", "Partner Integrations"] },
          { label: "AI & Health Tech", color: "text-emerald-400", skills: ["Python", "FastAPI", "Ollama", "LLMs", "RAG", "Biometrics", "PDF Reports"] },
          { label: "Developer Productivity", color: "text-purple-400", skills: ["AI Coding Agents", "Automated Code Review", "VAPT / CVE Remediation", "AI Enablement"] },
          { label: "Tools & Collaboration", color: "text-amber-400", skills: ["Git", "Bitbucket", "REST SDKs", "Deep Links", "Coupon Management"] },
        ].map(({ label, color, skills }) => (
          <div class="liquid-glass-card p-4 space-y-3">
            <div class={`text-xs font-bold uppercase tracking-widest ${color}`}>{label}</div>
            <div class="flex flex-wrap gap-1.5">
              {skills.map((s) => (
                <span class="liquid-glass-pill px-2.5 py-1 text-xs text-white/65">{s}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
