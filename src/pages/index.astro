---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-16 mt-1 space-y-10">

    <!-- ── Hero ─────────────────────────────────────────── -->
    <section class="space-y-6 pt-2">

      <!-- Live status -->
      <div class="inline-flex items-center gap-2 liquid-glass-pill px-4 py-2 text-xs font-semibold text-emerald-300">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        Backend Software Engineer · Policybazaar / DocPrime
      </div>

      <!-- Main headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-white">
        Building <span style="background:linear-gradient(135deg,#38bdf8,#818cf8,#34d399);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
          health-tech systems
        </span>
        <br/>& AI-powered features.
      </h1>

      <p class="text-base md:text-lg text-white/70 max-w-2xl leading-relaxed">
        I'm <span class="font-semibold text-white">Abhishek Singh</span> — a backend software engineer at
        <span class="text-sky-400 font-medium">Policybazaar</span>, building Java and Spring Boot services for DocPrime's healthcare and wellness platform. I work across APIs, data models, partner integrations, and AI-powered health features.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={`${import.meta.env.BASE_URL}resume.pdf`}
          target="_blank" rel="noopener"
          class="liquid-glass-btn-primary inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          Download Resume
        </a>
        <a href={`${import.meta.env.BASE_URL}projects`} class="liquid-glass-btn inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white/90">
          View Projects
        </a>
        <a href="https://github.com/ABHISHEK0S1INGH" target="_blank" rel="noopener" class="liquid-glass-btn inline-flex items-center gap-2 px-5 py-3 text-sm font-medium text-white/75">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"/>
          </svg>
          GitHub
        </a>
      </div>

      <!-- Code Terminal (Liquid Glass) -->
      <div class="liquid-terminal overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3 border-b border-white/10">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
            <span class="ml-3 text-xs font-mono text-white/40">ConsultationController.java</span>
          </div>
          <span class="text-xs font-mono text-emerald-400/70">Spring Boot · MySQL · AI</span>
        </div>
        <div class="p-5 text-xs sm:text-sm font-mono leading-loose text-slate-300 overflow-x-auto">
          <p><span class="text-indigo-400">@RestController</span></p>
          <p><span class="text-indigo-400">@RequestMapping</span>(<span class="text-emerald-300">"/api/v1/consultations"</span>)</p>
          <p><span class="text-sky-400">public class</span> <span class="text-amber-300">ConsultationController</span> &#123;</p>
          <p class="pl-5 mt-1"><span class="text-indigo-400">@PostMapping</span>(<span class="text-emerald-300">"/book"</span>)</p>
          <p class="pl-5"><span class="text-sky-400">public</span> ResponseEntity&lt;BookingResponse&gt; <span class="text-blue-300">createBooking</span>(<span class="text-indigo-400">@Valid @RequestBody</span> BookingRequest req) &#123;</p>
          <p class="pl-10 text-slate-500">// Integrate partners, persist health data, explain results with AI</p>
          <p class="pl-10"><span class="text-sky-400">return</span> ResponseEntity.ok(bookingService.process(req));</p>
          <p class="pl-5">&#125;</p>
          <p>&#125;</p>
        </div>
      </div>
    </section>

    <!-- ── Stats Row ──────────────────────────────────── -->
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {[
      { val: "Live", sub: "DocPrime Health Platform", color: "from-sky-400 to-blue-500" },
      { val: "AI",   sub: "Biometrics & Health Reports", color: "from-emerald-400 to-teal-500" },
      { val: "RAG",  sub: "On-Premise AI Assistant", color: "from-indigo-400 to-purple-500" },
      { val: "APIs", sub: "Partners & Mobile Experiences", color: "from-amber-400 to-orange-500" },
      ].map(({ val, sub, color }) => (
        <div class="liquid-glass-card p-4 text-center space-y-1">
          <div class={`text-2xl sm:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r ${color}`}>{val}</div>
          <div class="text-[11px] text-white/60 leading-tight">{sub}</div>
        </div>
      ))}
    </section>

    <!-- ── Architecture Bento ─────────────────────────── -->
    <section class="space-y-3">
      <div class="flex items-center justify-between pb-3 border-b border-white/10">
        <div>
          <h2 class="text-2xl font-bold text-white">System Architecture</h2>
          <p class="text-xs text-white/50 mt-0.5">How I design high-reliability distributed systems</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Flow card (2 col) -->
        <div class="md:col-span-2 liquid-glass-card p-5 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-widest text-sky-400">Microservice Request Flow</span>
            <span class="liquid-glass-pill px-2.5 py-1 text-[10px] font-mono text-white/50">Event-Driven</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-[11px] font-mono">
            {[
              { label: "Client Apps", sub: "Web / Mobile", color: "text-sky-300" },
              { label: "API Gateway", sub: "JWT + Rate Limit", color: "text-emerald-300" },
              { label: "Spring Boot", sub: "Business Logic", color: "text-indigo-300" },
              { label: "Kafka + DB",  sub: "PostgreSQL / Redis", color: "text-purple-300" },
            ].map(({ label, sub, color }) => (
              <div class="liquid-glass p-3 rounded-xl space-y-0.5">
                <div class={`font-semibold ${color}`}>{label}</div>
                <div class="text-white/40">{sub}</div>
              </div>
            ))}
          </div>
          <p class="text-xs text-white/65 leading-relaxed">
            Clean APIs, thoughtful database schemas, secure partner integrations, and AI-assisted health experiences — designed for a production wellness platform.
          </p>
        </div>

        <!-- Stack card -->
        <div class="liquid-glass-card p-5 space-y-3 flex flex-col">
          <span class="text-xs font-bold uppercase tracking-widest text-accent">Core Tech Stack</span>
          <div class="flex flex-wrap gap-1.5 grow">
            {["Java", "Spring Boot", "MySQL", "Python", "FastAPI", "Ollama / LLMs", "RAG", "REST APIs", "Git / Bitbucket"].map((t) => (
              <span class="liquid-glass-pill px-2.5 py-1 text-xs text-white/70">{t}</span>
            ))}
          </div>
          <a href={`${import.meta.env.BASE_URL}cv`} class="text-xs text-sky-400 hover:text-sky-300 font-medium transition-colors">
            Full Background & Skills →
          </a>
        </div>
      </div>
    </section>

    <!-- ── Experience ─────────────────────────────────── -->
    <section class="space-y-3">
      <div class="flex items-center justify-between pb-3 border-b border-white/10">
        <h2 class="text-2xl font-bold text-white">Work Experience</h2>
        <a href={`${import.meta.env.BASE_URL}cv`} class="text-xs text-sky-400 hover:underline font-medium">Full Timeline →</a>
      </div>

      <div class="space-y-3">
        <!-- PolicyBazaar -->
        <article class="liquid-glass-card p-5 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <div>
              <h3 class="font-bold text-lg text-white">Software Engineer (Backend)</h3>
              <div class="text-sm font-semibold text-sky-400">Policybazaar · DocPrime</div>
            </div>
            <span class="liquid-glass-pill px-3 py-1 text-xs font-mono text-white/60 w-fit">
              Present · Gurugram
            </span>
          </div>
          <ul class="list-disc ml-5 space-y-1.5 text-sm text-white/70 leading-relaxed">
            <li>Build <strong class="text-white/90">Java and Spring Boot REST APIs</strong> for the DocPrime mobile app and its healthcare and wellness features.</li>
            <li>Design and migrate <strong class="text-white/90">MySQL database schemas</strong>, with clean data models and production-ready integrations.</li>
            <li>Integrate partner platforms including <strong class="text-white/90">Hubble Money</strong> and Lenskart through SDKs, APIs, deep links, and coupon management.</li>
            <li>Develop <strong class="text-white/90">Aisha</strong> biometric health services, an on-premise Ollama/RAG assistant, and AI coding-review workflows.</li>
          </ul>
          <div class="flex flex-wrap gap-1.5">
            {["Java", "Spring Boot", "MySQL", "Python", "FastAPI", "Ollama", "RAG", "REST APIs"].map((t) => (
              <span class="liquid-glass-pill px-2.5 py-1 text-xs font-mono text-white/55">{t}</span>
            ))}
          </div>
        </article>

        <!-- AI developer productivity -->
        <article class="liquid-glass-card p-5 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <div>
              <h3 class="font-bold text-lg text-white">AI Coding & Developer Productivity</h3>
              <div class="text-sm font-semibold text-sky-400">Internal Engineering Work</div>
            </div>
            <span class="liquid-glass-pill px-3 py-1 text-xs font-mono text-white/60 w-fit">
              Ongoing
            </span>
          </div>
          <p class="text-sm text-white/70">Build AI coding agents, automated code-review workflows, and internal sessions that help developers use AI effectively in their daily work.</p>
          <div class="flex flex-wrap gap-1.5">
            {["Python", "Ollama", "LLMs", "RAG", "Code Review"].map((t) => (
              <span class="liquid-glass-pill px-2.5 py-1 text-xs font-mono text-white/55">{t}</span>
            ))}
          </div>
        </article>
      </div>
    </section>

    <!-- ── Featured Projects ──────────────────────────── -->
    <section class="space-y-3">
      <div class="flex items-center justify-between pb-3 border-b border-white/10">
        <h2 class="text-2xl font-bold text-white">Featured Projects</h2>
        <a href={`${import.meta.env.BASE_URL}projects`} class="text-xs text-sky-400 hover:underline font-medium">All Projects →</a>
      </div>

      <HorizontalCard
        title="Aisha — Biometric Health Assistant"
        img={`${import.meta.env.BASE_URL}aisha.jpg`}
        desc="FastAPI health service that analyses vital signs from a camera, detects emotion, analyses skin, and generates automated PDF health reports."
        url="https://github.com/ABHISHEK0S1INGH/AiSHA---Personal-Health-Assistant"
        badge="PRODUCTION LIVE"
        tags={["FastAPI", "Python", "Kafka", "AWS", "JWT", "rPPG"]}
      />

      <HorizontalCard
        title="Deal of the Day — DocPrime"
        img={`${import.meta.env.BASE_URL}website.png`}
        desc="DocPrime app module combining partner deals from MySQL with products pulled from the Hubble API, including personalised share messages."
        url="https://www.linkedin.com/in/abhishek0s1ingh/"
        badge="DOC PRIME"
        tags={["Java", "Spring Boot", "MySQL", "Hubble API", "Partner Integrations"]}
      />
    </section>

    <!-- ── Contact CTA ────────────────────────────────── -->
    <section class="liquid-glass-card p-8 text-center space-y-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Ready to build something impactful?</h2>
      <p class="text-sm text-white/65 max-w-xl mx-auto leading-relaxed">
        Building reliable health-tech products and AI-powered developer tools at the intersection of backend engineering and intelligent systems.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href="mailto:abhi620548@gmail.com" class="liquid-glass-btn-primary inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          abhi620548@gmail.com
        </a>
        <a href="https://www.linkedin.com/in/abhishek0s1ingh/" target="_blank" rel="noopener" class="liquid-glass-btn inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white/80">
          LinkedIn
        </a>
        <a href="https://github.com/ABHISHEK0S1INGH" target="_blank" rel="noopener" class="liquid-glass-btn inline-flex items-center gap-2 px-5 py-3 text-sm text-white/65">
          GitHub
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
