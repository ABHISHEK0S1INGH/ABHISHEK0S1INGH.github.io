---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects | Abhishek Singh" sideBarActiveItemID="projects">
  <div class="space-y-6 pb-12">
    <div class="pb-4 border-b border-white/10">
      <h1 class="text-3xl font-extrabold text-white mb-1">Featured Projects</h1>
      <p class="text-sm text-white/55 max-w-2xl">Backend microservices, data pipelines, and machine learning systems I've designed and shipped.</p>
    </div>

    <HorizontalCard
      title="AiSHA — Personal Health Assistant"
      img={`${import.meta.env.BASE_URL}aisha.jpg`}
      desc="Production biometric analysis microservice using contactless rPPG to compute 8+ health vitals (SpO2, HRV, blood pressure, stress). Built with FastAPI, Kafka, AWS, and JWT authentication. Live in PolicyBazaar's DocPrime ecosystem."
      url="https://github.com/ABHISHEK0S1INGH/AiSHA---Personal-Health-Assistant"
      badge="PRODUCTION LIVE"
      tags={["FastAPI", "Python", "Kafka", "AWS", "JWT", "Biometrics", "rPPG"]}
    />

    <HorizontalCard
      title="Data Warehouse & Analytics Platform"
      img={`${import.meta.env.BASE_URL}data_warehouse.png`}
      desc="End-to-end data warehousing and analytical processing solution demonstrating ingestion pipelines, warehouse schema modeling, aggregation queries, and dashboard insights."
      url="https://github.com/ABHISHEK0S1INGH/Data_warehouse"
      badge="DATA ARCHITECTURE"
      tags={["SQL", "ETL", "Schema Design", "Data Engineering", "Analytics"]}
    />

    <HorizontalCard
      title="Machine Learning Prediction App"
      img={`${import.meta.env.BASE_URL}machine-learning.jpg`}
      desc="Interactive ML application with Streamlit — upload CSVs, run automated feature preprocessing, model inference, and visualize predictions in real time."
      url="https://github.com/ABHISHEK0S1INGH/Machine-Learning-Prediction-App"
      tags={["Streamlit", "Python", "Scikit-Learn", "Data Visualization"]}
    />

    <HorizontalCard
      title="Real Estate Price Predictor"
      img={`${import.meta.env.BASE_URL}hourse_price.png`}
      desc="End-to-end ML pipeline covering EDA, correlation profiling, missing-value handling, feature scaling, and regression model evaluation in Jupyter."
      url="https://github.com/ABHISHEK0S1INGH/House_Price_Predictor"
      tags={["Python", "Jupyter", "Scikit-Learn", "Regression Analysis"]}
    />

    <div class="pt-2 flex justify-center">
      <a
        href="https://github.com/ABHISHEK0S1INGH?tab=repositories"
        target="_blank" rel="noopener"
        class="liquid-glass-btn inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white/80"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z" />
        </svg>
        More Repositories on GitHub →
      </a>
    </div>
  </div>
</BaseLayout>
