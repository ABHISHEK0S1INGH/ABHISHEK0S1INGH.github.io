---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay backdrop-blur-sm"></label>
    <aside class="glass-sidebar h-auto min-h-full w-[19rem] text-base-content flex flex-col">
    <!-- Theme toggle -->
    <div class="flex justify-end px-4 pt-4">
      <ThemeToggle />
    </div>

    <!-- Profile -->
    <div class="flex flex-col items-center py-6 px-4">
      <a href={import.meta.env.BASE_URL} class="group block">
        <div class="relative w-[7.5rem] h-[7.5rem]">
          <!-- Liquid ring -->
          <div class="absolute inset-0 rounded-full liquid-glass-btn-primary opacity-70 animate-[spin_8s_linear_infinite] blur-[2px] scale-110"></div>
          <div class="absolute inset-[3px] rounded-full overflow-hidden border-2 border-white/25 shadow-xl">
            <img
              src={`${import.meta.env.BASE_URL}profile.jpg`}
              alt="Abhishek Singh"
              width="300"
              height="300"
              loading="eager"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
          </div>
        </div>
      </a>

      <a href={import.meta.env.BASE_URL} class="mt-4 text-center no-underline">
        <div class="font-bold text-xl tracking-tight text-white">Abhishek Singh</div>
        <div class="text-xs font-semibold uppercase tracking-widest text-sky-400 mt-0.5">Backend Software Engineer</div>
      </a>

      <!-- Live status pill -->
      <div class="liquid-glass-pill inline-flex items-center gap-1.5 mt-3 px-4 py-1.5 text-xs font-medium text-emerald-300">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        Policybazaar · DocPrime
      </div>
    </div>

    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>
