---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-3 pt-3 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col border-r border-base-content/10">
    <!-- Desktop Theme Toggle -->
    <div class="flex justify-end items-center px-1 mb-1">
      <ThemeToggle />
    </div>

    <div class="w-fit mx-auto mt-2 mb-4">
      <a href={import.meta.env.BASE_URL} class="group block">
        <div class="avatar transition-transform duration-300 ease-out group-hover:scale-105 block m-auto">
          <div class="w-[8.5rem] rounded-full ring-2 ring-primary/40 ring-offset-4 ring-offset-base-200 overflow-hidden shadow-lg">
            <picture>
              <source srcset={`${import.meta.env.BASE_URL}profile.jpg`} type="image/jpeg" />
              <img
                class="w-full h-full object-cover"
                src={`${import.meta.env.BASE_URL}profile.jpg`}
                alt="Abhishek Singh"
                width="300"
                height="300"
                loading="eager"
              />
            </picture>
          </div>
        </div>
      </a>
    </div>

    <div class="text-center mb-5">
      <a href={import.meta.env.BASE_URL} class="no-underline">
        <div class="font-bold text-xl tracking-tight text-base-content">Abhishek Singh</div>
        <div class="text-xs font-semibold text-primary uppercase tracking-wider mt-1">Backend Engineer</div>
      </a>

      <!-- Status Indicator -->
      <div class="inline-flex items-center gap-1.5 mt-2.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Open to Opportunities
      </div>
    </div>

    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>
