---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
const tag_url = url ? url.split("/").slice(0, -1).join("/") + "/tag" : "";
---

<div
  class="rounded-xl bg-base-200/50 hover:bg-base-200 border border-base-content/10 hover:border-primary/40 transition-all duration-200 portfolio-card my-3"
>
  <a href={url} target={target} class="block p-5">
    <div class="flex flex-col md:flex-row gap-5 items-center md:items-start">
      {
        img && (
          <img
            src={img}
            width={750}
            height={422}
            alt={title}
            loading="lazy"
            class="w-full md:w-48 h-32 object-cover rounded-lg border border-base-content/5"
            onerror={`this.onerror=null;this.src='${import.meta.env.BASE_URL}post_img.webp';`}
          />
        )
      }
      <div class="grow w-full">
        <div class="flex items-center gap-2 flex-wrap mb-1">
          <h2 class="text-xl font-bold text-base-content hover:text-primary transition-colors">
            {title}
          </h2>
          {badge && <span class="badge badge-primary badge-sm font-semibold">{badge}</span>}
        </div>
        <p class="py-1 text-sm md:text-base text-base-content/80 leading-relaxed">{desc}</p>
        {
          tags && tags.length > 0 && (
            <div class="card-actions justify-end mt-2">
              {tags.map((tag) => (
                <span class="badge badge-outline badge-sm text-xs opacity-75">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </a>
</div>
