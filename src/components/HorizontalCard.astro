---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
---

<a href={url} target={target} class="liquid-glass-card group flex flex-col md:flex-row gap-5 p-5 my-4 no-underline">
  {img && (
    <div class="w-full md:w-48 h-36 shrink-0 rounded-xl overflow-hidden border border-white/10">
      <img
        src={img}
        width={750}
        height={422}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
        onerror={`this.onerror=null;this.src='${import.meta.env.BASE_URL}post_img.webp';`}
      />
    </div>
  )}

  <div class="grow space-y-2">
    <div class="flex items-center gap-2 flex-wrap">
      <h3 class="text-base md:text-lg font-bold text-white group-hover:text-sky-300 transition-colors">
        {title}
        <span class="text-white/30 group-hover:text-sky-400 transition-opacity opacity-0 group-hover:opacity-100 ml-1">↗</span>
      </h3>
      {badge && (
        <span class="liquid-glass-pill px-2.5 py-0.5 text-[10px] font-bold tracking-widest text-sky-300 uppercase">
          {badge}
        </span>
      )}
    </div>

    <p class="text-sm text-white/70 leading-relaxed">{desc}</p>

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-1">
        {tags.map((tag) => (
          <span class="liquid-glass-pill px-2.5 py-1 text-[11px] font-mono text-white/60">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
