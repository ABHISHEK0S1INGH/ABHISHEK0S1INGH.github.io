---
// ThemeToggle component for switching between dark ('night') and light ('lofi')
---

<button
  type="button"
  class="btn btn-ghost btn-circle btn-sm theme-toggle-btn border border-base-content/10 hover:border-primary/40 transition-colors"
  aria-label="Toggle dark/light theme"
  title="Toggle dark/light theme"
>
  <!-- Sun icon (visible in dark mode) -->
  <svg
    class="theme-icon-sun w-4 h-4 text-warning"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>

  <!-- Moon icon (visible in light mode) -->
  <svg
    class="theme-icon-moon w-4 h-4 text-primary"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  :global([data-theme="night"]) .theme-icon-sun,
  :global([data-theme="dark"]) .theme-icon-sun {
    display: block;
  }
  :global([data-theme="night"]) .theme-icon-moon,
  :global([data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  :global([data-theme="lofi"]) .theme-icon-sun,
  :global([data-theme="light"]) .theme-icon-sun {
    display: none;
  }
  :global([data-theme="lofi"]) .theme-icon-moon,
  :global([data-theme="light"]) .theme-icon-moon {
    display: block;
  }
</style>

<script is:inline>
  function setupThemeToggleButtons() {
    document.querySelectorAll(".theme-toggle-btn").forEach((btn) => {
      btn.onclick = () => {
        const current = document.documentElement.getAttribute("data-theme") || "night";
        const next = current === "night" || current === "dark" ? "lofi" : "night";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      };
    });
  }

  setupThemeToggleButtons();
  document.addEventListener("astro:after-swap", setupThemeToggleButtons);
</script>
